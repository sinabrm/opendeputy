NODE_ENV=development

# Self-hosted Docker. Copy this file to .env, then set a long random password.
# Docker Compose refuses to start while this value is empty.
OPENCHAMBER_UI_PASSWORD=
OPENDEPUTY_HEADLESS_BROWSER=true
# Keep 127.0.0.1 when a reverse proxy runs on the same server. Use 0.0.0.0 only
# when a firewall or private network protects direct access to port 3000.
OPENDEPUTY_BIND_ADDRESS=127.0.0.1
OPENDEPUTY_PORT=3000

# Optional advanced binary overrides. Leave blank to use automatic discovery.
# OPENDEPUTY_LIBREOFFICE_BINARY=C:\Program Files\LibreOffice\program\soffice.exe
# OPENDEPUTY_PIPER_BINARY=C:\Users\you\.opendeputy\workspace-tools\.venv\Scripts\piper.exe
# OPENDEPUTY_PIPER_VOICES_DIR=C:\Users\you\.opendeputy\workspace-tools\voices
# OPENDEPUTY_ACTIVITYWATCH_BINARY=C:\Program Files\ActivityWatch\aw-qt.exe
